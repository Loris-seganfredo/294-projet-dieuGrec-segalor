# Ces règles aident l’éditeur à mettre en forme les fichiers JavaScript, TypeScript et Vue.
[*.{js,jsx,ts,tsx,vue}]
# Utiliser des espaces pour décaler le code vers la droite.
indent_style = space
# Ajouter deux espaces par niveau.
indent_size = 2
# Enlever les espaces inutiles en fin de ligne à l’enregistrement.
trim_trailing_whitespace = true
# Mettre un retour à la ligne à la fin du fichier.
insert_final_newline = true
