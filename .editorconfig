# Règles d’écriture pour les fichiers JavaScript, TypeScript et Vue.
[*.{js,jsx,ts,tsx,vue}]
# Décaler le code avec deux espaces par niveau.
indent_style = space
indent_size = 2
# Nettoyer les espaces en fin de ligne et terminer le fichier par un retour à la ligne.
trim_trailing_whitespace = true
insert_final_newline = true
