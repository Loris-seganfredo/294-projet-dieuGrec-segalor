# Ignorer les fichiers de l’ordinateur, les bibliothèques installées et le résultat de la compilation.
.DS_Store
node_modules
/dist

# Garder les réglages locaux propres à chaque ordinateur.
.env
.env.local
.env.*.local

# Ignorer les journaux créés par les outils d’installation.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ignorer les réglages et fichiers temporaires des éditeurs de code.
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
